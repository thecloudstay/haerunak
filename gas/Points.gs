function popRank_(name, kind){
  var t = (kind === 'fish') ? POP_FX : POP_SP;
  var k = t.indexOf(name);
  return k < 0 ? 999 : k;
}

/** 해당 월에 제철인 대상만 점수순으로 반환 */
function inSeason_(list, month, table){
  var out = [];
  for (var k=0;k<list.length;k++){
    var t = table[list[k]];
    var v = t ? t[month-1] : 1;
    if (v > 0) out.push({ n:list[k], v:v });
  }
  out.sort(function(a,b){ return b.v - a.v; });
  return out;
}
