/** 원격 rigs.json 병합 후 이름으로 조회 */
function rigOf_(name){
  var ex = (typeof remoteJson_ === 'function') ? remoteJson_('rigs') : null;
  if (ex && ex[name]) return ex[name];
  return RIGS[name] || null;
}

/** 대상 목록 → 채비 카드 목록 (상위 3개) */
function rigsFor_(targets, mode){
  var out = [];
  (targets || []).slice(0, 3).forEach(function(t){
    var name = t.n || t;
    var r = rigOf_(mode === 'fish' && name === '주꾸미' ? '주꾸미(낚시)' : name);
    if (r) out.push({ n: name, t: r.t || [], b: r.b || '', tip: r.tip || '', warn: r.warn || '' });
  });
  return out;
}

