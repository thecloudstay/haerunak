/** 날짜가 [from,to] 구간 안인가 — 연말을 넘어가는 구간도 처리 */
function inBanRange_(m, d, from, to){
  var cur = m*100 + d, a = from[0]*100 + from[1], b = to[0]*100 + to[1];
  return a <= b ? (cur >= a && cur <= b) : (cur >= a || cur <= b);
}
function mdText_(x){ return x[0] + '월 ' + x[1] + '일'; }

/**
 * 대상물 하나의 금어기 상태.
 * @param name 채집물·어종 이름
 * @param mo,d 월·일
 * @param region 지점 행정구역 문자열 (예: '인천 옹진')
 * @return null 이면 해당 규정 없음
 *         {banned, from, to, size, unit, note, scope}
 */
function banStatus_(name, mo, d, region){
  region = region || '';
  var rules = (typeof effBans_ === 'function') ? effBans_().list : BANS;
  var local = null, national = null;
  for (var k = 0; k < rules.length; k++){
    var r = rules[k];
    var hit = (r.n === name) || (r.a && r.a.indexOf(name) >= 0);
    if (!hit) continue;
    if (r.rg === '전국'){ if (!national) national = r; }
    else if (region.indexOf(r.rg) >= 0){ local = r; }
  }
  var use = local || national;
  if (!use) return null;
  var banned = use.b ? inBanRange_(mo, d, use.b[0], use.b[1]) : false;
  return {
    banned: banned,
    from: use.b ? mdText_(use.b[0]) : null,
    to:   use.b ? mdText_(use.b[1]) : null,
    size: use.z, unit: use.u,
    note: use.note || '',
    scope: (local ? use.rg : '전국')
  };
}

/** 목록에서 금어기인 것과 아닌 것을 갈라준다 */
function splitByBan_(targets, mo, d, region){
  var ok = [], no = [];
  for (var k = 0; k < targets.length; k++){
    var t = targets[k];
    var st = banStatus_(t.n, mo, d, region);
    t.ban = st;
    if (st && st.banned) no.push(t); else ok.push(t);
  }
  return { ok: ok, banned: no };
}
