/** 해역대 판정 (조황 데이터 참조용) */
function zoneOf_(p){
  if(!p) return null;
  if(p.s==='W') return p.la>=37.15?'WN':(p.la>=36.2?'WM':'WS');
  if(p.s==='S') return p.lo<127.75?'SW':'SE';
  if(p.s==='E') return 'E';
  if(p.s==='J') return 'J';
  return null;
}
/** 실제 조황(잡힌 사례) 강도 — 0 비시즌 / 1 시즌 / 2 성수기 / null 자료없음. mo 1~12 */
function catchAt_(name, zone, mo){
  if(!zone) return null;
  var c = CATCH[name]; if(!c || !c[zone]) return null;
  var v = c[zone][mo-1];
  return (v===undefined||v===null)?null:v;
}

function pointById_(id){
  for (var k=0;k<POINTS.length;k++){ if (POINTS[k].i === id) return POINTS[k]; }
  return null;
}
function speciesOf_(p, kind){
  if (kind === 'haeru') return p.sp || SP_DEFAULT[p.s+'|'+p.f] || SP_DEFAULT[p.s+'|rock'] || [];
  return p.fx || FX_BY[p.s+'|'+p.f] || FX_DEFAULT[p.s] || [];
}
