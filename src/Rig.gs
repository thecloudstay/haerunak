/* ══════════ 도구 이름 → 상품군 정규화 ══════════
 * '장갑'·'두꺼운 장갑'·'목장갑'은 결국 같은 물건을 산다.
 * 상품군으로 묶어야 제휴 링크 하나가 여러 대상물을 덮는다. */
var GEAR_NORM = {
  '망':'채집망', '망태기':'채집망', '채집망':'채집망',
  '장갑':'작업 장갑', '두꺼운 장갑':'작업 장갑', '목장갑':'작업 장갑', '네오프렌 장갑':'네오프렌 장갑',
  '장화':'갯벌 장화', '긴 장화':'갯벌 장화',
  '랜턴':'방수 랜턴', '보조 랜턴':'방수 랜턴', '헤드랜턴':'헤드랜턴',
  '뜰채':'뜰채', '긴 뜰채':'뜰채', '소형 통발형 뜰채':'뜰채',
  '갈퀴':'갯벌 갈퀴', '갈퀴(그레)':'갯벌 갈퀴',
  '호미':'갯벌 호미',
  '집게':'집게',
  '통':'채집통',
  '맛소금':'맛소금', '소금':'맛소금',
  '조새(굴칼)':'조새',
  '칼':'작업칼', '일자 드라이버나 칼':'작업칼',
  '구명조끼(자동팽창형 권장)':'구명조끼',
  '휴대폰 방수팩':'방수팩',
  '호루라기':'호루라기'
};

/** 도구 이름을 상품군으로 바꾼다. 매칭 없으면 원래 이름 그대로. */
function gearKey_(name){
  if (!name) return '';
  var n = String(name).trim();
  if (GEAR_NORM[n]) return GEAR_NORM[n];
  // 부분 일치 — '두꺼운 방수 장갑' 같은 변형도 잡는다
  for (var k in GEAR_NORM){
    if (n.indexOf(k) >= 0) return GEAR_NORM[k];
  }
  return n;
}
